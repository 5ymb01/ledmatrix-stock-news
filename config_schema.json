{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stock News Ticker Plugin Configuration",
  "description": "Configuration schema for the Stock News Ticker plugin",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable or disable the stock news ticker plugin"
    },
    "live_priority": {
      "type": "boolean",
      "description": "Take over display when live market news is available",
      "default": false
    },
    "global": {
      "type": "object",
      "properties": {
        "display_duration": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "description": "Duration in seconds to display the stock news ticker"
        },
        "update_interval": {
          "type": "integer",
          "default": 3600,
          "minimum": 60,
          "maximum": 3600,
          "description": "How often to fetch new stock news headlines (seconds)"
        },
        "scroll_speed": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 10,
          "description": "Scrolling speed multiplier"
        },
        "scroll_delay": {
          "type": "number",
          "default": 0.01,
          "minimum": 0.001,
          "maximum": 0.1,
          "description": "Delay between scroll steps in seconds"
        },
        "max_headlines_per_symbol": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum headlines to show per stock symbol"
        },
        "headlines_per_rotation": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "Number of headlines to show per rotation"
        },
        "dynamic_duration": {
          "type": "boolean",
          "default": true,
          "description": "Enable dynamic duration based on content width"
        },
        "min_duration": {
          "type": "integer",
          "default": 30,
          "minimum": 10,
          "maximum": 300,
          "description": "Minimum display duration when dynamic duration is enabled"
        },
        "max_duration": {
          "type": "integer",
          "default": 300,
          "minimum": 30,
          "maximum": 600,
          "description": "Maximum display duration when dynamic duration is enabled"
        },
        "duration_buffer": {
          "type": "number",
          "default": 0.1,
          "minimum": 0.01,
          "maximum": 1.0,
          "description": "Duration buffer for dynamic duration calculation"
        },
        "scroll_pixels_per_second": {
          "type": "number",
          "default": 25.0,
          "minimum": 5.0,
          "maximum": 50.0,
          "description": "Scroll speed in pixels per second"
        },
        "scroll_target_fps": {
          "type": "number",
          "default": 100.0,
          "minimum": 30.0,
          "maximum": 200.0,
          "description": "Target FPS for scrolling"
        },
        "scroll_mode": {
          "type": "string",
          "enum": ["one_shot", "continuous"],
          "default": "one_shot",
          "description": "Scrolling mode"
        },
        "scroll_direction": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "left",
          "description": "Scroll direction"
        },
        "enable_scroll_metrics": {
          "type": "boolean",
          "default": false,
          "description": "Enable scroll performance metrics"
        },
        "font": {
          "type": "string",
          "title": "Display Font",
          "enum": ["10x20", "9x18B", "9x18", "9x15B", "9x15", "8x13B", "8x13", "7x14B", "7x14", "7x13B", "7x13", "6x13B", "6x12", "6x10"],
          "default": "10x20",
          "description": "Bitmap font for headlines. Larger fonts are more legible. Bold variants (B suffix) have thicker strokes. Number format is WIDTHxHEIGHT in pixels."
        },
        "background_service": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable background data fetching"
            },
            "request_timeout": {
              "type": "integer",
              "default": 30,
              "minimum": 10,
              "maximum": 120,
              "description": "Request timeout in seconds"
            },
            "max_retries": {
              "type": "integer",
              "default": 5,
              "minimum": 1,
              "maximum": 10,
              "description": "Maximum number of retries for failed requests"
            },
            "priority": {
              "type": "integer",
              "default": 2,
              "minimum": 1,
              "maximum": 5,
              "description": "Priority for background requests (1=highest, 5=lowest)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "feeds": {
      "type": "object",
      "properties": {
        "news_source": {
          "type": "string",
          "title": "News Source",
          "enum": ["yahoo", "google_news", "seeking_alpha"],
          "default": "google_news",
          "description": "RSS provider for per-symbol stock news. 'yahoo' = Yahoo Finance, 'google_news' = Google News (broadest coverage), 'seeking_alpha' = Seeking Alpha (analysis-focused)"
        },
        "market_feeds": {
          "type": "object",
          "title": "General Market Feeds",
          "description": "Toggle built-in general market news feeds (not per-symbol)",
          "properties": {
            "cnbc": {
              "type": "boolean",
              "title": "CNBC Top News",
              "description": "Include CNBC top business and market news",
              "default": false
            },
            "marketwatch": {
              "type": "boolean",
              "title": "MarketWatch",
              "description": "Include MarketWatch top stories",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "stock_symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,5}$",
            "description": "Stock symbol (e.g., AAPL, GOOGL)"
          },
          "uniqueItems": true,
          "maxItems": 50,
          "default": ["AAPL", "GOOGL", "MSFT"],
          "description": "List of stock symbols to track news for"
        },
        "custom_feeds": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "string",
              "format": "uri",
              "description": "Custom RSS feed URL"
            }
          },
          "additionalProperties": false,
          "description": "Custom RSS feed URLs with user-defined names"
        },
        "text_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [0, 255, 0],
          "description": "RGB color for headline text"
        },
        "symbol_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [255, 255, 0],
          "description": "RGB color for stock symbols"
        },
        "separator_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3,
          "default": [255, 0, 0],
          "description": "RGB color for separators between headlines"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": ["enabled"]
}
